{
  "name": "dataarcus-site",
  "private": true,
  "description": "Tests and build helpers for dataarcus.com (the site itself needs no build).",
  "scripts": {
    "test": "node scripts/tests/run-all.mjs",
    "test:full": "node scripts/tests/run-all.mjs --full",
    "build:min": "node scripts/check-min.mjs --write",
    "check:min": "node scripts/check-min.mjs",
    "pages:deps": "node scripts/cdn.mjs --write",
    "lint": "eslint mcp assets/js \"**/*.html\"",
    "coverage:mcp": "c8 node mcp/run-tests.mjs --keep-going"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "aos": "2.3.4",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.2",
    "c8": "12.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-html": "8.2.1",
    "globals": "17.13.0",
    "playwright-core": "1.64.1",
    "pngjs": "^7.0.0",
    "terser": "5.51.2"
  }
}
