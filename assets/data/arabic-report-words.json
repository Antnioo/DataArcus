  "_allow": "Where a variant may stay, each with why: a path pattern (whole files) or a path plus a text the line contains.",
  "allow": [
    {
      "path": "^(articles/|ar/articles/|assets/js/translations/article-)(?!power-bi-report-ready-for-arabic\\.)",
      "why": "Blog articles: published text, reported in mcp/work/E.md; only a clear error is changed. The Arabic-readiness article (W, 25 Oct) is new and checked like a page."
    },
    {
      "path": "^content/",
      "why": "The owner's post plans and drafts (blog and LinkedIn): published or to be published text, as the articles."
    },
    {
      "path": "^scripts/make-article-mockups\\.mjs$",
      "why": "It draws the blog articles' published images (their text is the articles')."
    },
    {
      "path": "\\.min\\.js$",
      "why": "Built from its source (check:min); the source is checked."
    },
    {
      "path": "^mcp/(work/|WORK\\.md|CHANGELOG\\.md|research/|plans/)|^scripts/tests/DESKTOP-TESTS\\.md$|^ROADMAP|^BACKLOG",
      "why": "History and notes keep the words of their day (as versions do: the owner's rule of 16 Oct)."
    },
    {
      "path": "(^|/)test[^/]*\\.mjs$|^scripts/tests/|^mcp/(test-models|fixtures|golden|lab)/|^scripts/test-",
      "why": "Tests and fixtures: they quote what an engine writes (checked by their own run) or what a user types (made-up models)."
    },
    {
      "path": "^assets/data/arabic-report-words\\.json$",
      "why": "The sheet itself names every variant."
    },
    {
      "path": "^mcp/lib/arabic-terms\\.mjs$",
      "why": "The scanner itself (mcp/lib/arabic-terms.mjs) names no term but its patterns."
    }
  ]
}
