	partition Calendar = calculated
		mode: import
		source =
				-- DAX calendar table generated by dataarcus.com/tools/dax-calendar-table-generator.html
				-- 2022-01-01 to 2027-12-31 · week starts Sunday · weekend sat-sun · fiscal year starts month 1
				VAR _Dates = CALENDAR ( DATE ( 2022, 1, 1 ), DATE ( 2027, 12, 31 ) )
				-- Umm al-Qura Hijri month starts, generated by dataarcus.com
				VAR _HijriMonths =
				    DATATABLE (
				        "HStart", DATETIME, "HYear", INTEGER, "HMonth", INTEGER,
				        {
				            { "2021-12-05", 1443, 5 },
				            { "2022-01-04", 1443, 6 },
				            { "2022-02-02", 1443, 7 },
				            { "2022-03-04", 1443, 8 },
				            { "2022-04-02", 1443, 9 },
				            { "2022-05-02", 1443, 10 },
				            { "2022-05-31", 1443, 11 },
				            { "2022-06-30", 1443, 12 },
				            { "2022-07-30", 1444, 1 },
				            { "2022-08-28", 1444, 2 },
				            { "2022-09-27", 1444, 3 },
				            { "2022-10-26", 1444, 4 },
				            { "2022-11-25", 1444, 5 },
				            { "2022-12-25", 1444, 6 },
				            { "2023-01-23", 1444, 7 },
				            { "2023-02-21", 1444, 8 },
				            { "2023-03-23", 1444, 9 },
				            { "2023-04-21", 1444, 10 },
				            { "2023-05-21", 1444, 11 },
				            { "2023-06-19", 1444, 12 },
				            { "2023-07-19", 1445, 1 },
				            { "2023-08-17", 1445, 2 },
				            { "2023-09-16", 1445, 3 },
				            { "2023-10-16", 1445, 4 },
				            { "2023-11-15", 1445, 5 },
				            { "2023-12-14", 1445, 6 },
				            { "2024-01-13", 1445, 7 },
				            { "2024-02-11", 1445, 8 },
				            { "2024-03-11", 1445, 9 },
				            { "2024-04-10", 1445, 10 },
				            { "2024-05-09", 1445, 11 },
				            { "2024-06-07", 1445, 12 },
				            { "2024-07-07", 1446, 1 },
				            { "2024-08-05", 1446, 2 },
				            { "2024-09-04", 1446, 3 },
				            { "2024-10-04", 1446, 4 },
				            { "2024-11-03", 1446, 5 },
				            { "2024-12-02", 1446, 6 },
				            { "2025-01-01", 1446, 7 },
				            { "2025-01-31", 1446, 8 },
				            { "2025-03-01", 1446, 9 },
				            { "2025-03-30", 1446, 10 },
				            { "2025-04-29", 1446, 11 },
				            { "2025-05-28", 1446, 12 },
				            { "2025-06-26", 1447, 1 },
				            { "2025-07-26", 1447, 2 },
				            { "2025-08-24", 1447, 3 },
				            { "2025-09-23", 1447, 4 },
				            { "2025-10-23", 1447, 5 },
				            { "2025-11-22", 1447, 6 },
				            { "2025-12-21", 1447, 7 },
				            { "2026-01-20", 1447, 8 },
				            { "2026-02-18", 1447, 9 },
				            { "2026-03-20", 1447, 10 },
				            { "2026-04-18", 1447, 11 },
				            { "2026-05-18", 1447, 12 },
				            { "2026-06-16", 1448, 1 },
				            { "2026-07-15", 1448, 2 },
				            { "2026-08-14", 1448, 3 },
				            { "2026-09-12", 1448, 4 },
				            { "2026-10-12", 1448, 5 },
				            { "2026-11-11", 1448, 6 },
				            { "2026-12-10", 1448, 7 },
				            { "2027-01-09", 1448, 8 },
				            { "2027-02-08", 1448, 9 },
				            { "2027-03-09", 1448, 10 },
				            { "2027-04-08", 1448, 11 },
				            { "2027-05-07", 1448, 12 },
				            { "2027-06-06", 1449, 1 },
				            { "2027-07-05", 1449, 2 },
				            { "2027-08-03", 1449, 3 },
				            { "2027-09-02", 1449, 4 },
				            { "2027-10-01", 1449, 5 },
				            { "2027-10-31", 1449, 6 },
				            { "2027-11-29", 1449, 7 },
				            { "2027-12-29", 1449, 8 }
				        }
				    )
				VAR _WithHijri =
				    ADDCOLUMNS (
				        ADDCOLUMNS (
				            _Dates,
				            "Hijri Month Start", MAXX ( FILTER ( _HijriMonths, [HStart] <= [Date] ), [HStart] )
				        ),
				        "Hijri Year", MAXX ( FILTER ( _HijriMonths, [HStart] = [Hijri Month Start] ), [HYear] ),
				        "Hijri Month Number", MAXX ( FILTER ( _HijriMonths, [HStart] = [Hijri Month Start] ), [HMonth] ),
				        "Hijri Day", INT ( [Date] - [Hijri Month Start] ) + 1
				    )
				RETURN
				    ADDCOLUMNS (
				        _WithHijri,
				        "Year", YEAR ( [Date] ),
				        "Quarter", "Q" & ROUNDUP ( MONTH ( [Date] ) / 3, 0 ),
				        "Year Quarter", YEAR ( [Date] ) & " Q" & ROUNDUP ( MONTH ( [Date] ) / 3, 0 ),
				        "Month Number", MONTH ( [Date] ),
				        "Month Name", SWITCH ( MONTH ( [Date] ), 1, "January", 2, "February", 3, "March", 4, "April", 5, "May", 6, "June", 7, "July", 8, "August", 9, "September", 10, "October", 11, "November", 12, "December" ),
				        "Month Short", SWITCH ( MONTH ( [Date] ), 1, "Jan", 2, "Feb", 3, "Mar", 4, "Apr", 5, "May", 6, "Jun", 7, "Jul", 8, "Aug", 9, "Sep", 10, "Oct", 11, "Nov", 12, "Dec" ),
				        "Year Month", FORMAT ( [Date], "YYYY-MM" ),
				        "Year Month Sort", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				        "Day", DAY ( [Date] ),
				        "Day of Week", WEEKDAY ( [Date], 1 ),
				        "Day Name", SWITCH ( WEEKDAY ( [Date], 1 ), 1, "Sunday", 2, "Monday", 3, "Tuesday", 4, "Wednesday", 5, "Thursday", 6, "Friday", 7, "Saturday" ),
				        "Week Start", [Date] - ( WEEKDAY ( [Date], 1 ) ) + 1,
				        "ISO Week", WEEKNUM ( [Date], 21 ),
				        "Is Weekend", WEEKDAY ( [Date], 1 ) IN { 7, 1 },
				        "Is Working Day", NOT ( WEEKDAY ( [Date], 1 ) IN { 7, 1 } ),
				        "Fiscal Year", "FY" & YEAR ( [Date] ),
				        "Fiscal Month Number", MONTH ( [Date] ),
				        "Fiscal Quarter", "FQ" & ROUNDUP ( MONTH ( [Date] ) / 3, 0 ),
				        "Day Offset", INT ( [Date] - TODAY () ),
				        "Month Offset", ( YEAR ( [Date] ) - YEAR ( TODAY () ) ) * 12 + MONTH ( [Date] ) - MONTH ( TODAY () ),
				        "Year Offset", YEAR ( [Date] ) - YEAR ( TODAY () ),
				        "Is Past", [Date] < TODAY (),
				        "Hijri Month Name", SWITCH ( [Hijri Month Number], 1, "Muharram", 2, "Safar", 3, "Rabi al-Awwal", 4, "Rabi al-Thani", 5, "Jumada al-Ula", 6, "Jumada al-Akhirah", 7, "Rajab", 8, "Sha'ban", 9, "Ramadan", 10, "Shawwal", 11, "Dhu al-Qa'dah", 12, "Dhu al-Hijjah" ),
				        "Hijri Date", [Hijri Day] & " " & SWITCH ( [Hijri Month Number], 1, "Muharram", 2, "Safar", 3, "Rabi al-Awwal", 4, "Rabi al-Thani", 5, "Jumada al-Ula", 6, "Jumada al-Akhirah", 7, "Rajab", 8, "Sha'ban", 9, "Ramadan", 10, "Shawwal", 11, "Dhu al-Qa'dah", 12, "Dhu al-Hijjah" ) & " " & [Hijri Year],
				        "Hijri Year Month Sort", [Hijri Year] * 100 + [Hijri Month Number],
				        "Is Ramadan", [Hijri Month Number] = 9,
				        "Ramadan Day", IF ( [Hijri Month Number] = 9, [Hijri Day] ),
				        "Is Eid al-Fitr", [Hijri Month Number] = 10 && [Hijri Day] <= 3,
				        "Is Eid al-Adha", [Hijri Month Number] = 12 && [Hijri Day] >= 10 && [Hijri Day] <= 13
				    )

