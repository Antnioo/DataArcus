model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","TMDLView_Desktop","MCP-PBIModeling"]

annotation PBI_QueryOrder = ["Sales","Calendar","_Measures","Sales Agg"]

ref table Sales
ref table Calendar
ref table _Measures
ref table 'Sales Agg'

