// Generated by dataarcus.com/tools/dax-measure-builder.html
// Power BI Desktop: open DAX query view, paste, then click "Update model: Add new measure"
// above each MEASURE line (or "Update model with changes" for all of them).
DEFINE
    MEASURE 'Sales'[Total Sales] =
        SUM ( 'Sales'[Amount] )

    MEASURE 'Sales'[Total Sales Last Ramadan] =
        VAR _RamadanDays =
            FILTER (
                SUMMARIZE ( 'Calendar', 'Calendar'[Hijri Year], 'Calendar'[Ramadan Day] ),
                NOT ISBLANK ( 'Calendar'[Ramadan Day] )
            )
        VAR _SameDaysLastYear =
            SELECTCOLUMNS (
                _RamadanDays,
                "Hijri Year", 'Calendar'[Hijri Year] - 1,
                "Ramadan Day", 'Calendar'[Ramadan Day]
            )
        RETURN
            CALCULATE (
                [Total Sales],
                REMOVEFILTERS ( 'Calendar' ),
                TREATAS ( _SameDaysLastYear, 'Calendar'[Hijri Year], 'Calendar'[Ramadan Day] )
            )

    MEASURE 'Sales'[Total Sales vs Last Ramadan %] =
        VAR _ThisRamadan = CALCULATE ( [Total Sales], KEEPFILTERS ( 'Calendar'[Is Ramadan] = TRUE () ) )
        VAR _LastRamadan = [Total Sales Last Ramadan]
        RETURN
            DIVIDE ( _ThisRamadan - _LastRamadan, _LastRamadan )

    MEASURE 'Sales'[Total Sales Eid al-Fitr Window] =
        VAR _DaysBefore = 7
        VAR _EidDays = 3
        VAR _Eids =
            SELECTCOLUMNS (
                FILTER ( 'Calendar', 'Calendar'[Hijri Month Number] = 10 && 'Calendar'[Hijri Day] = 1 ),
                "@Eid", 'Calendar'[Date]
            )
        VAR _Window =
            FILTER (
                ALL ( 'Calendar'[Date] ),
                VAR _Day = 'Calendar'[Date]
                RETURN
                    NOT ISEMPTY (
                        FILTER ( _Eids, _Day >= [@Eid] - _DaysBefore && _Day <= [@Eid] + _EidDays - 1 )
                    )
            )
        RETURN
            IF (
                NOT ISEMPTY ( _Eids ),
                CALCULATE ( [Total Sales], REMOVEFILTERS ( 'Calendar' ), _Window )
            )

    MEASURE 'Sales'[Total Sales Eid al-Fitr Window Last Year] =
        VAR _DaysBefore = 7
        VAR _EidDays = 3
        VAR _Years =
            SELECTCOLUMNS (
                FILTER ( 'Calendar', 'Calendar'[Hijri Month Number] = 10 && 'Calendar'[Hijri Day] = 1 ),
                "@Year", 'Calendar'[Hijri Year] - 1
            )
        VAR _Eids =
            SELECTCOLUMNS (
                FILTER ( ALL ( 'Calendar' ), 'Calendar'[Hijri Month Number] = 10 && 'Calendar'[Hijri Day] = 1 && 'Calendar'[Hijri Year] IN _Years ),
                "@Eid", 'Calendar'[Date]
            )
        VAR _Window =
            FILTER (
                ALL ( 'Calendar'[Date] ),
                VAR _Day = 'Calendar'[Date]
                RETURN
                    NOT ISEMPTY (
                        FILTER ( _Eids, _Day >= [@Eid] - _DaysBefore && _Day <= [@Eid] + _EidDays - 1 )
                    )
            )
        RETURN
            IF (
                NOT ISEMPTY ( _Years ),
                CALCULATE ( [Total Sales], REMOVEFILTERS ( 'Calendar' ), _Window )
            )

    MEASURE 'Sales'[Total Sales Eid al-Fitr Window vs Last Year %] =
        DIVIDE ( [Total Sales Eid al-Fitr Window] - [Total Sales Eid al-Fitr Window Last Year], [Total Sales Eid al-Fitr Window Last Year] )

    MEASURE 'Sales'[Total Sales Eid al-Adha Window] =
        VAR _DaysBefore = 7
        VAR _EidDays = 4
        VAR _Eids =
            SELECTCOLUMNS (
                FILTER ( 'Calendar', 'Calendar'[Hijri Month Number] = 12 && 'Calendar'[Hijri Day] = 10 ),
                "@Eid", 'Calendar'[Date]
            )
        VAR _Window =
            FILTER (
                ALL ( 'Calendar'[Date] ),
                VAR _Day = 'Calendar'[Date]
                RETURN
                    NOT ISEMPTY (
                        FILTER ( _Eids, _Day >= [@Eid] - _DaysBefore && _Day <= [@Eid] + _EidDays - 1 )
                    )
            )
        RETURN
            IF (
                NOT ISEMPTY ( _Eids ),
                CALCULATE ( [Total Sales], REMOVEFILTERS ( 'Calendar' ), _Window )
            )

    MEASURE 'Sales'[Total Sales Eid al-Adha Window Last Year] =
        VAR _DaysBefore = 7
        VAR _EidDays = 4
        VAR _Years =
            SELECTCOLUMNS (
                FILTER ( 'Calendar', 'Calendar'[Hijri Month Number] = 12 && 'Calendar'[Hijri Day] = 10 ),
                "@Year", 'Calendar'[Hijri Year] - 1
            )
        VAR _Eids =
            SELECTCOLUMNS (
                FILTER ( ALL ( 'Calendar' ), 'Calendar'[Hijri Month Number] = 12 && 'Calendar'[Hijri Day] = 10 && 'Calendar'[Hijri Year] IN _Years ),
                "@Eid", 'Calendar'[Date]
            )
        VAR _Window =
            FILTER (
                ALL ( 'Calendar'[Date] ),
                VAR _Day = 'Calendar'[Date]
                RETURN
                    NOT ISEMPTY (
                        FILTER ( _Eids, _Day >= [@Eid] - _DaysBefore && _Day <= [@Eid] + _EidDays - 1 )
                    )
            )
        RETURN
            IF (
                NOT ISEMPTY ( _Years ),
                CALCULATE ( [Total Sales], REMOVEFILTERS ( 'Calendar' ), _Window )
            )

    MEASURE 'Sales'[Total Sales Eid al-Adha Window vs Last Year %] =
        DIVIDE ( [Total Sales Eid al-Adha Window] - [Total Sales Eid al-Adha Window Last Year], [Total Sales Eid al-Adha Window Last Year] )

EVALUATE
    { [Total Sales] }
