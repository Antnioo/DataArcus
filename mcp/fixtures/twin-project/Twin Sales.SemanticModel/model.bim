{
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "tables": [
      {
        "name": "Sales",
        "partitions": [
          {
            "name": "Sales",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let Source = #table(type table [#\"Order Date\" = datetime, Region = text, Product = text, Amount = number], {}) in Source"
            }
          }
        ],
        "columns": [
          {
            "name": "Order Date",
            "dataType": "dateTime",
            "sourceColumn": "Order Date"
          },
          {
            "name": "Region",
            "dataType": "string",
            "sourceColumn": "Region"
          },
          {
            "name": "Product",
            "dataType": "string",
            "sourceColumn": "Product"
          },
          {
            "name": "Amount",
            "dataType": "double",
            "sourceColumn": "Amount"
          }
        ],
        "measures": [
          {
            "name": "Total Sales",
            "expression": "SUM ( Sales[Amount] )",
            "formatString": "#,0"
          },
          {
            "name": "Orders",
            "expression": "COUNTROWS ( Sales )",
            "formatString": "#,0"
          }
        ]
      },
      {
        "name": "Calendar",
        "dataCategory": "Time",
        "partitions": [
          {
            "name": "Calendar",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let Source = #table(type table [Date = datetime, #\"Month Number\" = Int64.Type, #\"Month Name\" = text, Year = Int64.Type], {}) in Source"
            }
          }
        ],
        "columns": [
          {
            "name": "Date",
            "dataType": "dateTime",
            "isKey": true,
            "sourceColumn": "Date"
          },
          {
            "name": "Month Number",
            "dataType": "int64",
            "sourceColumn": "Month Number"
          },
          {
            "name": "Month Name",
            "dataType": "string",
            "sourceColumn": "Month Name",
            "sortByColumn": "Month Number"
          },
          {
            "name": "Year",
            "dataType": "int64",
            "sourceColumn": "Year"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "rel-sales-calendar",
        "fromTable": "Sales",
        "fromColumn": "Order Date",
        "toTable": "Calendar",
        "toColumn": "Date"
      }
    ]
  }
}
