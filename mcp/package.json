{
  "name": "dataarcus-mcp",
  "version": "0.3.1",
  "description": "DataArcus design and model tools for Power BI as an MCP server, on your own computer. It reads and checks Power BI models and reports, and writes new reports, themes and scripts after your approval.",
  "private": true,
  "type": "module",
  "bin": {
    "dataarcus-mcp": "server.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node run-tests.mjs"
  },
  "engines": {
    "node": ">=20.10"
  },
  "dependencies": {
    "@microsoft/powerbi-core-visual-schema": "0.1.3",
    "@microsoft/powerbi-report-authoring-cli": "0.5.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "pngjs": "^7.0.0"
  }
}
