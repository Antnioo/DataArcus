table Dates

	column Date
		dataType: dateTime
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Date]

	column Year
		dataType: int64
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Year]

	column 'Month Number'
		dataType: int64
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Month Number]

	column 'Month Name'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Month Name]

	column 'Day Name'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Day Name]

	partition Dates = calculated
		mode: import
		source = DATATABLE ( "Date", DATETIME, "Year", INTEGER, "Month Number", INTEGER, "Month Name", STRING, "Day Name", STRING, { { "2026-01-03T00:00:00", 2026, 1, "January", "Saturday" }, { "2026-01-16T00:00:00", 2026, 1, "January", "Friday" }, { "2026-02-04T00:00:00", 2026, 2, "February", "Wednesday" }, { "2026-02-17T00:00:00", 2026, 2, "February", "Tuesday" }, { "2026-03-05T00:00:00", 2026, 3, "March", "Thursday" }, { "2026-03-18T00:00:00", 2026, 3, "March", "Wednesday" }, { "2026-04-06T00:00:00", 2026, 4, "April", "Monday" }, { "2026-04-19T00:00:00", 2026, 4, "April", "Sunday" }, { "2026-05-07T00:00:00", 2026, 5, "May", "Thursday" }, { "2026-05-20T00:00:00", 2026, 5, "May", "Wednesday" }, { "2026-06-08T00:00:00", 2026, 6, "June", "Monday" }, { "2026-06-21T00:00:00", 2026, 6, "June", "Sunday" } } )
