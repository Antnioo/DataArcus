table Dates

	column Date
		dataType: dateTime
		sourceColumn: Date

	column Year
		dataType: int64
		sourceColumn: Year

	column 'Month Name'
		dataType: string
		sourceColumn: Month Name

	column 'Day Name'
		dataType: string
		sourceColumn: Day Name

	partition Dates = m
		mode: import
		source =
				let
				    Source = #table({"Date", "Year", "Month Name", "Day Name"}, {{#datetime(2026, 1, 4, 0, 0, 0), 2026, "January", "Sunday"}, {#datetime(2026, 1, 5, 0, 0, 0), 2026, "January", "Monday"}, {#datetime(2026, 1, 6, 0, 0, 0), 2026, "January", "Tuesday"}, {#datetime(2026, 1, 7, 0, 0, 0), 2026, "January", "Wednesday"}, {#datetime(2026, 1, 8, 0, 0, 0), 2026, "January", "Thursday"}, {#datetime(2026, 1, 9, 0, 0, 0), 2026, "January", "Friday"}, {#datetime(2026, 1, 10, 0, 0, 0), 2026, "January", "Saturday"}, {#datetime(2026, 1, 11, 0, 0, 0), 2026, "January", "Sunday"}, {#datetime(2026, 1, 12, 0, 0, 0), 2026, "January", "Monday"}, {#datetime(2026, 1, 13, 0, 0, 0), 2026, "January", "Tuesday"}, {#datetime(2026, 1, 14, 0, 0, 0), 2026, "January", "Wednesday"}, {#datetime(2026, 1, 15, 0, 0, 0), 2026, "January", "Thursday"}, {#datetime(2026, 1, 16, 0, 0, 0), 2026, "January", "Friday"}, {#datetime(2026, 1, 17, 0, 0, 0), 2026, "January", "Saturday"}})
				in
				    Source
