table Orders

	column 'Order Id'
		dataType: int64
		sourceColumn: Order Id

	column 'Order Date'
		dataType: dateTime
		sourceColumn: Order Date

	column Region
		dataType: string
		sourceColumn: Region

	column Product
		dataType: string
		sourceColumn: Product

	column Amount
		dataType: double
		sourceColumn: Amount

	column Quantity
		dataType: int64
		sourceColumn: Quantity

	column 'Discount Rate'
		dataType: double
		sourceColumn: Discount Rate

	partition Orders = m
		mode: import
		source =
				let
				    Source = #table({"Order Id", "Order Date", "Region", "Product", "Amount", "Quantity", "Discount Rate"}, {{1001, #datetime(2026, 1, 4, 0, 0, 0), "North", "Alpha", 200, 1, 0}, {1002, #datetime(2026, 1, 5, 0, 0, 0), "South", "Beta", 400, 2, 0.05}, {1003, #datetime(2026, 1, 6, 0, 0, 0), "East", "Gamma", 600, 3, 0.1}, {1004, #datetime(2026, 1, 7, 0, 0, 0), "West", "Alpha", 800, 4, 0}, {1005, #datetime(2026, 1, 8, 0, 0, 0), "North", "Beta", 1000, 1, 0.05}, {1006, #datetime(2026, 1, 9, 0, 0, 0), "South", "Gamma", 200, 2, 0.1}, {1007, #datetime(2026, 1, 10, 0, 0, 0), "East", "Alpha", 400, 3, 0}, {1008, #datetime(2026, 1, 11, 0, 0, 0), "West", "Beta", 600, 4, 0.05}, {1009, #datetime(2026, 1, 12, 0, 0, 0), "North", "Gamma", 800, 1, 0.1}, {1010, #datetime(2026, 1, 13, 0, 0, 0), "South", "Alpha", 1000, 2, 0}, {1011, #datetime(2026, 1, 14, 0, 0, 0), "East", "Beta", 200, 3, 0.05}, {1012, #datetime(2026, 1, 15, 0, 0, 0), "West", "Gamma", 400, 4, 0.1}, {1013, #datetime(2026, 1, 16, 0, 0, 0), "North", "Alpha", 600, 1, 0}, {1014, #datetime(2026, 1, 17, 0, 0, 0), "South", "Beta", 800, 2, 0.05}, {1015, #datetime(2026, 1, 4, 0, 0, 0), "East", "Gamma", 1000, 3, 0.1}, {1016, #datetime(2026, 1, 5, 0, 0, 0), "West", "Alpha", 200, 4, 0}, {1017, #datetime(2026, 1, 6, 0, 0, 0), "North", "Beta", 400, 1, 0.05}, {1018, #datetime(2026, 1, 7, 0, 0, 0), "South", "Gamma", 600, 2, 0.1}, {1019, #datetime(2026, 1, 8, 0, 0, 0), "East", "Alpha", 800, 3, 0}, {1020, #datetime(2026, 1, 9, 0, 0, 0), "West", "Beta", 1000, 4, 0.05}, {1021, #datetime(2026, 1, 10, 0, 0, 0), "North", "Gamma", 200, 1, 0.1}, {1022, #datetime(2026, 1, 11, 0, 0, 0), "South", "Alpha", 400, 2, 0}, {1023, #datetime(2026, 1, 12, 0, 0, 0), "East", "Beta", 600, 3, 0.05}, {1024, #datetime(2026, 1, 13, 0, 0, 0), "West", "Gamma", 800, 4, 0.1}, {1025, #datetime(2026, 1, 14, 0, 0, 0), "North", "Alpha", 1000, 1, 0}, {1026, #datetime(2026, 1, 15, 0, 0, 0), "South", "Beta", 200, 2, 0.05}, {1027, #datetime(2026, 1, 16, 0, 0, 0), "East", "Gamma", 400, 3, 0.1}, {1028, #datetime(2026, 1, 17, 0, 0, 0), "West", "Alpha", 600, 4, 0}})
				in
				    Source
