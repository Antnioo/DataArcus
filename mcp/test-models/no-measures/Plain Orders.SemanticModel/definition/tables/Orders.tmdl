table Orders

	column 'Order Id'
		dataType: int64
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Order Id]

	column 'Order Date'
		dataType: dateTime
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Order Date]

	column Region
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Region]

	column Product
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Product]

	column Amount
		dataType: double
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Amount]

	column Quantity
		dataType: int64
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Quantity]

	column 'Discount Rate'
		dataType: double
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Discount Rate]

	partition Orders = calculated
