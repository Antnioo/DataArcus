table 'Freight Costs'

	measure 'Freight Costs Total Tax Amount' = SUM ( 'Freight Costs'[Tax Amount] )
		formatString: #,0
		displayFolder: Logistics

	measure 'Freight Costs Average Tax Amount' = AVERAGE ( 'Freight Costs'[Tax Amount] )
		formatString: #,0.00
		displayFolder: Logistics

	measure 'Freight Costs Count' = COUNTROWS ( 'Freight Costs' )
		formatString: #,0
		displayFolder: Logistics

	measure 'Freight Costs Total Tax Amount LY' = CALCULATE ( [Freight Costs Total Tax Amount], SAMEPERIODLASTYEAR ( 'Calendar'[Date] ) )
		formatString: #,0
		displayFolder: Logistics

	measure 'Freight Costs Total Tax Amount YoY %' = DIVIDE ( [Freight Costs Total Tax Amount] - [Freight Costs Total Tax Amount LY], [Freight Costs Total Tax Amount LY] )
		formatString: 0.0%

	/// Made-up measure for the large test model (Logistics).
	measure 'Freight Costs Total Tax Amount YTD' = TOTALYTD ( [Freight Costs Total Tax Amount], 'Calendar'[Date] )
		formatString: #,0
		displayFolder: Logistics

	measure 'Freight Costs Max Tax Amount' = MAX ( 'Freight Costs'[Tax Amount] )
		displayFolder: Logistics

	measure 'Freight Costs Tax Amount Share %' = DIVIDE ( [Freight Costs Total Tax Amount], CALCULATE ( [Freight Costs Total Tax Amount], ALL ( 'Freight Costs' ) ) )
		displayFolder: Logistics

	measure 'Freight Costs Total Units' = SUM ( 'Freight Costs'[Units] )
		formatString: #,0

	/// Made-up measure for the large test model (Logistics).
	measure 'Freight Costs Average Units' = AVERAGE ( 'Freight Costs'[Units] )
		formatString: #,0.00
		displayFolder: Logistics

	measure 'Freight Costs Total Units LY' = CALCULATE ( [Freight Costs Total Units], SAMEPERIODLASTYEAR ( 'Calendar'[Date] ) )
		displayFolder: Logistics

	measure 'Freight Costs Total Units YoY %' = DIVIDE ( [Freight Costs Total Units] - [Freight Costs Total Units LY], [Freight Costs Total Units LY] )
		displayFolder: Logistics

	measure 'Freight Costs Total Units YTD' = TOTALYTD ( [Freight Costs Total Units], 'Calendar'[Date] )
		formatString: #,0
		displayFolder: Logistics

	measure 'Freight Costs Max Units' = MAX ( 'Freight Costs'[Units] )
		displayFolder: Logistics

	measure 'Freight Costs Units Share %' = DIVIDE ( [Freight Costs Total Units], CALCULATE ( [Freight Costs Total Units], ALL ( 'Freight Costs' ) ) )
		displayFolder: Logistics

	column 'Freight Cost Id'
		dataType: int64
		isHidden
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Freight Cost Id]

	column Date
		dataType: dateTime
		isHidden
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Date]

	column 'Port Key'
		dataType: int64
		isHidden
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Port Key]

	column 'Hub Key'
		dataType: int64
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Hub Key]

	column 'Delay Reason Key'
		dataType: int64
		isHidden
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Delay Reason Key]

	column 'Delivery Status Key'
		dataType: int64
		isHidden
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Delivery Status Key]

	column 'Customs Status Key'
		dataType: int64
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Customs Status Key]

	column 'Return Reason Key'
		dataType: int64
		isHidden
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Return Reason Key]

	column 'Tax Amount'
		dataType: double
		isHidden
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Tax Amount]

	column Units
		dataType: int64
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Units]

	column Score
		dataType: decimal
		isHidden
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Score]

	column Margin
		dataType: decimal
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Margin]

	column Price
		dataType: double
		isHidden
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Price]

	column Count
		dataType: int64
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Count]

	column 'Net Amount'
		dataType: decimal
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Net Amount]

	partition 'Freight Costs' = calculated
		mode: import
		source = VAR B = ADDCOLUMNS ( CROSSJOIN ( CALENDAR ( DATE ( 2024, 1, 1 ), DATE ( 2025, 12, 31 ) ), GENERATESERIES ( 1, 3 ) ), "S", MOD ( INT ( [Date] ) * 7919 + [Value] * 104729 + 35092143, 1000 ) ) RETURN SELECTCOLUMNS ( B, "Freight Cost Id", ( INT ( [Date] ) - 45000 ) * 10 + [Value], "Date", [Date], "Port Key", 1 + MOD ( [S] + [Value] + 74, 8 ), "Hub Key", 1 + MOD ( [S] + [Value] + 111, 8 ), "Delay Reason Key", 1 + MOD ( [S] + [Value] + 148, 8 ), "Delivery Status Key", 1 + MOD ( [S] + [Value] + 185, 8 ), "Customs Status Key", 1 + MOD ( [S] + [Value] + 222, 8 ), "Return Reason Key", 1 + MOD ( [S] + [Value] + 259, 8 ), "Tax Amount",  ( ROUND ( ( 40 + MOD ( [S] * 11, 900 ) ) * IF ( YEAR ( [Date] ) = 2025, 1.12, 1 ) * IF ( WEEKDAY ( [Date], 1 ) >= 6, 1.25, 1 ), 2 ) ), "Units", 1 + MOD ( [S] * 11, 40 ), "Score", CURRENCY ( ROUND ( ( 40 + MOD ( [S] * 13, 900 ) ) * IF ( YEAR ( [Date] ) = 2025, 1.12, 1 ) * IF ( WEEKDAY ( [Date], 1 ) >= 6, 1.25, 1 ), 2 ) ), "Margin", CURRENCY ( ROUND ( ( 40 + MOD ( [S] * 14, 900 ) ) * IF ( YEAR ( [Date] ) = 2025, 1.12, 1 ) * IF ( WEEKDAY ( [Date], 1 ) >= 6, 1.25, 1 ), 2 ) ), "Price",  ( ROUND ( ( 40 + MOD ( [S] * 15, 900 ) ) * IF ( YEAR ( [Date] ) = 2025, 1.12, 1 ) * IF ( WEEKDAY ( [Date], 1 ) >= 6, 1.25, 1 ), 2 ) ), "Count", 1 + MOD ( [S] * 15, 40 ), "Net Amount", CURRENCY ( ROUND ( ( 40 + MOD ( [S] * 17, 900 ) ) * IF ( YEAR ( [Date] ) = 2025, 1.12, 1 ) * IF ( WEEKDAY ( [Date], 1 ) >= 6, 1.25, 1 ), 2 ) ) )
