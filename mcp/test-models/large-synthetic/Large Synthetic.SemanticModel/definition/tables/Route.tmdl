table Route

	column 'Route Key'
		dataType: int64
		isHidden
		sourceColumn: Route Key

	column Route
		dataType: string
		sourceColumn: Route

	column 'Route Created By'
		dataType: string
		sourceColumn: Route Created By

	column 'Route Code'
		dataType: string
		sourceColumn: Route Code

	column 'Route Description'
		dataType: string
		sourceColumn: Route Description

	column 'Route Group'
		dataType: string
		sourceColumn: Route Group

	partition Route = m
		mode: import
		source =
				let
				    Source = #table({"Route Key", "Route", "Route Created By", "Route Code", "Route Description", "Route Group"}, {})
				in
				    Source
