table Route

	column 'Route Key'
		dataType: int64
		isHidden
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Route Key]

	column Route
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Route]

	column 'Route Created By'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Route Created By]

	column 'Route Code'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Route Code]

	column 'Route Description'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Route Description]

	column 'Route Group'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Route Group]

	partition Route = calculated
		mode: import
		source = SELECTCOLUMNS ( GENERATESERIES ( 1, 8 ), "Route Key", [Value], "Route", "Route " & [Value], "Route Created By", "Created By " & ( 1 + MOD ( [Value] + 2, 3 ) ), "Route Code", "Code " & ( 1 + MOD ( [Value] + 3, 3 ) ), "Route Description", "Description " & ( 1 + MOD ( [Value] + 4, 3 ) ), "Route Group", "Group " & ( 1 + MOD ( [Value] + 5, 3 ) ) )
