table 'Service Level'

	column 'Service Level Key'
		dataType: int64
		isHidden
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Service Level Key]

	column 'Service Level'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Service Level]

	column 'Service Level Status'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Service Level Status]

	column 'Service Level Type'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Service Level Type]

	column 'Service Level Owner'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Service Level Owner]

	column 'Service Level Valid From'
		dataType: dateTime
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Service Level Valid From]

	column 'Service Level Region'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Service Level Region]

	column 'Service Level Code'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Service Level Code]

	column 'Service Level Description'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Service Level Description]

	partition 'Service Level' = calculated
		mode: import
		source = SELECTCOLUMNS ( GENERATESERIES ( 1, 8 ), "Service Level Key", [Value], "Service Level", "Service Level " & [Value], "Service Level Status", "Status " & ( 1 + MOD ( [Value] + 2, 3 ) ), "Service Level Type", "Type " & ( 1 + MOD ( [Value] + 3, 3 ) ), "Service Level Owner", "Owner " & ( 1 + MOD ( [Value] + 4, 3 ) ), "Service Level Valid From", DATE ( 2024, [Value], 1 ), "Service Level Region", "Region " & ( 1 + MOD ( [Value] + 6, 3 ) ), "Service Level Code", "Code " & ( 1 + MOD ( [Value] + 7, 3 ) ), "Service Level Description", "Description " & ( 1 + MOD ( [Value] + 8, 3 ) ) )
