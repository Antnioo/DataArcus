table 'Delay Reason'

	column 'Delay Reason Key'
		dataType: int64
		isHidden
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Delay Reason Key]

	column 'Delay Reason'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Delay Reason]

	column 'Delay Reason Status'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Delay Reason Status]

	column 'Delay Reason Is Active'
		dataType: boolean
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Delay Reason Is Active]

	column 'Delay Reason Created By'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Delay Reason Created By]

	column 'Delay Reason Valid To'
		dataType: dateTime
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Delay Reason Valid To]

	column 'Delay Reason Code'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Delay Reason Code]

	column 'Delay Reason Description'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Delay Reason Description]

	partition 'Delay Reason' = calculated
		mode: import
		source = SELECTCOLUMNS ( GENERATESERIES ( 1, 8 ), "Delay Reason Key", [Value], "Delay Reason", "Delay Reason " & [Value], "Delay Reason Status", "Status " & ( 1 + MOD ( [Value] + 2, 3 ) ), "Delay Reason Is Active", MOD ( [Value], 2 ) = 1, "Delay Reason Created By", "Created By " & ( 1 + MOD ( [Value] + 4, 3 ) ), "Delay Reason Valid To", DATE ( 2024, [Value], 1 ), "Delay Reason Code", "Code " & ( 1 + MOD ( [Value] + 6, 3 ) ), "Delay Reason Description", "Description " & ( 1 + MOD ( [Value] + 7, 3 ) ) )
