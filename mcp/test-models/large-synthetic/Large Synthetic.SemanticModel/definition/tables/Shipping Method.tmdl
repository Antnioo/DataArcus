table 'Shipping Method'

	column 'Shipping Method Key'
		dataType: int64
		isHidden
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Shipping Method Key]

	column 'Shipping Method'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Shipping Method]

	column 'Shipping Method Short Name'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Shipping Method Short Name]

	column 'Shipping Method Category'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Shipping Method Category]

	column 'Shipping Method Code'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Shipping Method Code]

	column 'Shipping Method Description'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Shipping Method Description]

	partition 'Shipping Method' = calculated
		mode: import
		source = SELECTCOLUMNS ( GENERATESERIES ( 1, 8 ), "Shipping Method Key", [Value], "Shipping Method", "Shipping Method " & [Value], "Shipping Method Short Name", "Short Name " & ( 1 + MOD ( [Value] + 2, 3 ) ), "Shipping Method Category", "Category " & ( 1 + MOD ( [Value] + 3, 3 ) ), "Shipping Method Code", "Code " & ( 1 + MOD ( [Value] + 4, 3 ) ), "Shipping Method Description", "Description " & ( 1 + MOD ( [Value] + 5, 3 ) ) )
