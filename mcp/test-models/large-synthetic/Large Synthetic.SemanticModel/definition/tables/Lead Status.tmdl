table 'Lead Status'

	column 'Lead Status Key'
		dataType: int64
		isHidden
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Lead Status Key]

	column 'Lead Status'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Lead Status]

	column 'Lead Status Short Name'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Lead Status Short Name]

	column 'Lead Status Group'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Lead Status Group]

	column 'Lead Status Long Name'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Lead Status Long Name]

	column 'Lead Status Code'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Lead Status Code]

	column 'Lead Status Description'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Lead Status Description]

	partition 'Lead Status' = calculated
		mode: import
		source = SELECTCOLUMNS ( GENERATESERIES ( 1, 8 ), "Lead Status Key", [Value], "Lead Status", "Lead Status " & [Value], "Lead Status Short Name", "Short Name " & ( 1 + MOD ( [Value] + 2, 3 ) ), "Lead Status Group", "Group " & ( 1 + MOD ( [Value] + 3, 3 ) ), "Lead Status Long Name", "Long Name " & ( 1 + MOD ( [Value] + 4, 3 ) ), "Lead Status Code", "Code " & ( 1 + MOD ( [Value] + 5, 3 ) ), "Lead Status Description", "Description " & ( 1 + MOD ( [Value] + 6, 3 ) ) )
