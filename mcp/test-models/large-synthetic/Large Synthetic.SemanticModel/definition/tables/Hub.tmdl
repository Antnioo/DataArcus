table Hub

	column 'Hub Key'
		dataType: int64
		isHidden
		sourceColumn: Hub Key

	column Hub
		dataType: string
		sourceColumn: Hub

	column 'Hub Code'
		dataType: string
		sourceColumn: Hub Code

	column 'Hub Created By'
		dataType: string
		sourceColumn: Hub Created By

	column 'Hub Is Active'
		dataType: boolean
		sourceColumn: Hub Is Active

	column 'Hub Short Name'
		dataType: string
		sourceColumn: Hub Short Name

	column 'Hub Owner'
		dataType: string
		sourceColumn: Hub Owner

	column 'Hub Description'
		dataType: string
		sourceColumn: Hub Description

	column 'Hub Region'
		dataType: string
		sourceColumn: Hub Region

	column 'Hub Group'
		dataType: string
		sourceColumn: Hub Group

	column 'Hub Category'
		dataType: string
		sourceColumn: Hub Category

	partition Hub = m
		mode: import
		source =
				let
				    Source = #table({"Hub Key", "Hub", "Hub Code", "Hub Created By", "Hub Is Active", "Hub Short Name", "Hub Owner", "Hub Description", "Hub Region", "Hub Group", "Hub Category"}, {})
				in
				    Source
