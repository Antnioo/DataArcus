table 'Container Type'

	column 'Container Type Key'
		dataType: int64
		isHidden
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Container Type Key]

	column 'Container Type'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Container Type]

	column 'Container Type Valid From'
		dataType: dateTime
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Container Type Valid From]

	column 'Container Type Region'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Container Type Region]

	column 'Container Type External Id'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Container Type External Id]

	column 'Container Type Code'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Container Type Code]

	column 'Container Type Description'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Container Type Description]

	partition 'Container Type' = calculated
		mode: import
		source = SELECTCOLUMNS ( GENERATESERIES ( 1, 8 ), "Container Type Key", [Value], "Container Type", "Container Type " & [Value], "Container Type Valid From", DATE ( 2024, [Value], 1 ), "Container Type Region", "Region " & ( 1 + MOD ( [Value] + 3, 3 ) ), "Container Type External Id", "External Id " & ( 1 + MOD ( [Value] + 4, 3 ) ), "Container Type Code", "Code " & ( 1 + MOD ( [Value] + 5, 3 ) ), "Container Type Description", "Description " & ( 1 + MOD ( [Value] + 6, 3 ) ) )
