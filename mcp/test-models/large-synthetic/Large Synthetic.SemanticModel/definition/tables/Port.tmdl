table Port

	column 'Port Key'
		dataType: int64
		isHidden
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Port Key]

	column Port
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Port]

	column 'Port Sort Order'
		dataType: int64
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Port Sort Order]

	column 'Port Created By'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Port Created By]

	column 'Port Status'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Port Status]

	column 'Port Code'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Port Code]

	column 'Port Description'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Port Description]

	partition Port = calculated
		mode: import
		source = SELECTCOLUMNS ( GENERATESERIES ( 1, 8 ), "Port Key", [Value], "Port", "Port " & [Value], "Port Sort Order", [Value], "Port Created By", "Created By " & ( 1 + MOD ( [Value] + 3, 3 ) ), "Port Status", "Status " & ( 1 + MOD ( [Value] + 4, 3 ) ), "Port Code", "Code " & ( 1 + MOD ( [Value] + 5, 3 ) ), "Port Description", "Description " & ( 1 + MOD ( [Value] + 6, 3 ) ) )
