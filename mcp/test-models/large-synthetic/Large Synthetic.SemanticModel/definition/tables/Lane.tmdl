table Lane

	column 'Lane Key'
		dataType: int64
		isHidden
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Lane Key]

	column Lane
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Lane]

	column 'Lane Region'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Lane Region]

	column 'Lane Sort Order'
		dataType: int64
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Lane Sort Order]

	column 'Lane Code'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Lane Code]

	column 'Lane Description'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Lane Description]

	partition Lane = calculated
		mode: import
		source = SELECTCOLUMNS ( GENERATESERIES ( 1, 8 ), "Lane Key", [Value], "Lane", "Lane " & [Value], "Lane Region", "Region " & ( 1 + MOD ( [Value] + 2, 3 ) ), "Lane Sort Order", [Value], "Lane Code", "Code " & ( 1 + MOD ( [Value] + 4, 3 ) ), "Lane Description", "Description " & ( 1 + MOD ( [Value] + 5, 3 ) ) )
