table Returns

	measure 'Returns Total Amount' = SUM ( Returns[Amount] )
		formatString: #,0
		displayFolder: Logistics

	measure 'Returns Average Amount' = AVERAGE ( Returns[Amount] )
		formatString: #,0.00
		displayFolder: Logistics

	measure 'Returns Count' = COUNTROWS ( Returns )
		formatString: #,0

	measure 'Returns Total Amount LY' = CALCULATE ( [Returns Total Amount], SAMEPERIODLASTYEAR ( 'Calendar'[Date] ) )
		formatString: #,0
		displayFolder: Logistics

	measure 'Returns Total Amount YoY %' = DIVIDE ( [Returns Total Amount] - [Returns Total Amount LY], [Returns Total Amount LY] )
		displayFolder: Logistics

	measure 'Returns Total Amount YTD' = TOTALYTD ( [Returns Total Amount], 'Calendar'[Date] )
		formatString: #,0
		displayFolder: Logistics

	measure 'Returns Max Amount' = MAX ( Returns[Amount] )
		displayFolder: Logistics

	measure 'Returns Amount Share %' = DIVIDE ( [Returns Total Amount], CALCULATE ( [Returns Total Amount], ALL ( Returns ) ) )
		displayFolder: Logistics

	measure 'Returns Total Weight Kg' = SUM ( Returns[Weight Kg] )

	measure 'Returns Average Weight Kg' = AVERAGE ( Returns[Weight Kg] )
		displayFolder: Logistics

	measure 'Returns Total Weight Kg LY' = CALCULATE ( [Returns Total Weight Kg], SAMEPERIODLASTYEAR ( 'Calendar'[Date] ) )
		formatString: #,0
		displayFolder: Logistics

	measure 'Returns Total Weight Kg YoY %' = DIVIDE ( [Returns Total Weight Kg] - [Returns Total Weight Kg LY], [Returns Total Weight Kg LY] )
		formatString: 0.0%
		displayFolder: Logistics

	measure 'Returns Total Weight Kg YTD' = TOTALYTD ( [Returns Total Weight Kg], 'Calendar'[Date] )
		formatString: #,0

	measure 'Returns Max Weight Kg' = MAX ( Returns[Weight Kg] )
		displayFolder: Logistics

	measure 'Returns Weight Kg Share %' = DIVIDE ( [Returns Total Weight Kg], CALCULATE ( [Returns Total Weight Kg], ALL ( Returns ) ) )
		displayFolder: Logistics

	column 'Return Id'
		dataType: int64
		isHidden
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Return Id]

	column Date
		dataType: dateTime
		isHidden
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Date]

	column 'Port Key'
		dataType: int64
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Port Key]

	column 'Fleet Unit Key'
		dataType: int64
		isHidden
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Fleet Unit Key]

	column 'Logistics Lookup 010 Key'
		dataType: int64
		isHidden
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Logistics Lookup 010 Key]

	column 'Logistics Lookup 046 Key'
		dataType: int64
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Logistics Lookup 046 Key]

	column 'Logistics Lookup 029 Key'
		dataType: int64
		isHidden
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Logistics Lookup 029 Key]

	column 'Logistics Lookup 024 Key'
		dataType: int64
		isHidden
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Logistics Lookup 024 Key]

	column Amount
		dataType: double
		isHidden
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Amount]

	column 'Weight Kg'
		dataType: double
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Weight Kg]

	column Count
		dataType: int64
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Count]

	column Cost
		dataType: double
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Cost]

	column Units
		dataType: int64
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Units]

	column 'Net Amount'
		dataType: double
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Net Amount]

	partition Returns = calculated
		mode: import
		source = VAR B = ADDCOLUMNS ( CROSSJOIN ( CALENDAR ( DATE ( 2024, 1, 1 ), DATE ( 2025, 12, 31 ) ), GENERATESERIES ( 1, 3 ) ), "S", MOD ( INT ( [Date] ) * 7919 + [Value] * 104729 + 36391852, 1000 ) ) RETURN SELECTCOLUMNS ( B, "Return Id", ( INT ( [Date] ) - 45000 ) * 10 + [Value], "Date", [Date], "Port Key", 1 + MOD ( [S] + [Value] + 74, 8 ), "Fleet Unit Key", 1 + MOD ( [S] + [Value] + 111, 8 ), "Logistics Lookup 010 Key", 1 + MOD ( [S] + [Value] + 148, 8 ), "Logistics Lookup 046 Key", 1 + MOD ( [S] + [Value] + 185, 8 ), "Logistics Lookup 029 Key", 1 + MOD ( [S] + [Value] + 222, 8 ), "Logistics Lookup 024 Key", 1 + MOD ( [S] + [Value] + 259, 8 ), "Amount",  ( ROUND ( ( 40 + MOD ( [S] * 11, 900 ) ) * IF ( YEAR ( [Date] ) = 2025, 1.12, 1 ) * IF ( WEEKDAY ( [Date], 1 ) >= 6, 1.25, 1 ), 2 ) ), "Weight Kg",  ( ROUND ( ( 40 + MOD ( [S] * 12, 900 ) ) * IF ( YEAR ( [Date] ) = 2025, 1.12, 1 ) * IF ( WEEKDAY ( [Date], 1 ) >= 6, 1.25, 1 ), 2 ) ), "Count", 1 + MOD ( [S] * 12, 40 ), "Cost",  ( ROUND ( ( 40 + MOD ( [S] * 14, 900 ) ) * IF ( YEAR ( [Date] ) = 2025, 1.12, 1 ) * IF ( WEEKDAY ( [Date], 1 ) >= 6, 1.25, 1 ), 2 ) ), "Units", 1 + MOD ( [S] * 14, 40 ), "Net Amount",  ( ROUND ( ( 40 + MOD ( [S] * 16, 900 ) ) * IF ( YEAR ( [Date] ) = 2025, 1.12, 1 ) * IF ( WEEKDAY ( [Date], 1 ) >= 6, 1.25, 1 ), 2 ) ) )
