{
  "name": "service-theme.json",
  "dataColors": [
    "#2B7BB9",
    "#E07A1F",
    "#4C9F70",
    "#8C5BB5",
    "#C8463D",
    "#3A8FA3"
  ],
  "background": "#FFFFFF",
  "foreground": "#252423",
  "tableAccent": "#2B7BB9",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "radius": 12
          }
        ],
        "dropShadow": [
          {
            "show": true
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "dropShadow": [
          {
            "show": true
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F2F1"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}
