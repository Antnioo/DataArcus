/// Made up: the age bands of an open work order.
table 'Dim Age Bucket'

	column 'Age Bucket'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Age Bucket]
		sortByColumn: 'Bucket Order'

	column 'Bucket Order'
		dataType: int64
		isNameInferred
		isDataTypeInferred
		summarizeBy: none
		sourceColumn: [Bucket Order]

	partition 'Dim Age Bucket' = calculated
		mode: import
		source = DATATABLE ( "Age Bucket", STRING, "Bucket Order", INTEGER, { { "0-30 days", 1 }, { "31-90 days", 2 }, { "91-180 days", 3 }, { "Over 180 days", 4 } } )
