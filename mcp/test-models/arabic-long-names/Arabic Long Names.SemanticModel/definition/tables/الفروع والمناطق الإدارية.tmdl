table 'الفروع والمناطق الإدارية'

	column 'رمز الفرع'
		dataType: int64
		isNameInferred
		isDataTypeInferred
		sourceColumn: [رمز الفرع]

	column 'اسم الفرع التجاري الرئيسي'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [اسم الفرع التجاري الرئيسي]

	column 'المنطقة الإدارية والمحافظة التابعة لها'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [المنطقة الإدارية والمحافظة التابعة لها]

	column 'فئة الفرع حسب حجم المساحة التجارية'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [فئة الفرع حسب حجم المساحة التجارية]

	partition 'الفروع والمناطق الإدارية' = calculated
		mode: import
		source = DATATABLE ( "رمز الفرع", INTEGER, "اسم الفرع التجاري الرئيسي", STRING, "المنطقة الإدارية والمحافظة التابعة لها", STRING, "فئة الفرع حسب حجم المساحة التجارية", STRING, { { 1, "Branch A", "Region 1", "Small" }, { 2, "Branch B", "Region 1", "Large" }, { 3, "Branch C", "Region 2", "Small" }, { 4, "Branch D", "Region 2", "Large" } } )
