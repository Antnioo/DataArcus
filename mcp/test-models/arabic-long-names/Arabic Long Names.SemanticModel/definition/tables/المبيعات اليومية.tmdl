table 'المبيعات اليومية'

	measure 'إجمالي صافي المبيعات بعد الخصومات والمرتجعات' = SUM ( 'المبيعات اليومية'[صافي المبلغ] )
		formatString: #,0

	measure 'عدد الفواتير الصادرة خلال الفترة المحددة' = COUNTROWS ( 'المبيعات اليومية' )
		formatString: #,0

	measure 'متوسط قيمة الفاتورة الواحدة بعد الخصم' = DIVIDE ( [إجمالي صافي المبيعات بعد الخصومات والمرتجعات], [عدد الفواتير الصادرة خلال الفترة المحددة] )
		formatString: #,0.00

	measure 'نسبة النمو مقارنة بنفس الفترة من العام الماضي' = ```
			VAR _LY = CALCULATE ( [إجمالي صافي المبيعات بعد الخصومات والمرتجعات], SAMEPERIODLASTYEAR ( 'التقويم'[التاريخ] ) )
			RETURN DIVIDE ( [إجمالي صافي المبيعات بعد الخصومات والمرتجعات] - _LY, _LY )
			```
		formatString: 0.0%

	measure 'إجمالي الكمية المباعة من جميع الأصناف' = SUM ( 'المبيعات اليومية'[الكمية] )
		formatString: #,0

	column 'التاريخ'
		dataType: dateTime
		isNameInferred
		isDataTypeInferred
		sourceColumn: [التاريخ]

	column 'رمز الفرع'
		dataType: int64
		isNameInferred
		isDataTypeInferred
		sourceColumn: [رمز الفرع]

	column 'صافي المبلغ'
		dataType: double
		isNameInferred
		isDataTypeInferred
		sourceColumn: [صافي المبلغ]

	column 'الكمية'
		dataType: int64
		isNameInferred
		isDataTypeInferred
		sourceColumn: [الكمية]

	column 'قناة البيع المستخدمة في إتمام العملية'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [قناة البيع المستخدمة في إتمام العملية]

	partition 'المبيعات اليومية' = calculated
		mode: import
		source = DATATABLE ( "التاريخ", DATETIME, "رمز الفرع", INTEGER, "صافي المبلغ", DOUBLE, "الكمية", INTEGER, "قناة البيع المستخدمة في إتمام العملية", STRING, { { "2025-01-01T00:00:00", 1, 100, 1, "Online" }, { "2025-01-02T00:00:00", 2, 200, 2, "Store" }, { "2025-01-03T00:00:00", 3, 300, 3, "Online" }, { "2025-01-04T00:00:00", 4, 400, 1, "Store" }, { "2025-01-05T00:00:00", 1, 500, 2, "Online" }, { "2025-01-06T00:00:00", 2, 100, 3, "Store" }, { "2025-01-07T00:00:00", 3, 200, 1, "Online" }, { "2026-01-01T00:00:00", 4, 600, 2, "Store" }, { "2026-01-02T00:00:00", 1, 800, 3, "Online" }, { "2026-01-03T00:00:00", 2, 1000, 1, "Store" }, { "2026-01-04T00:00:00", 3, 200, 2, "Online" }, { "2026-01-05T00:00:00", 4, 400, 3, "Store" }, { "2026-01-06T00:00:00", 1, 600, 1, "Online" }, { "2026-01-07T00:00:00", 2, 800, 2, "Store" }, { "2025-01-01T00:00:00", 3, 500, 3, "Online" }, { "2025-01-02T00:00:00", 4, 100, 1, "Store" }, { "2025-01-03T00:00:00", 1, 200, 2, "Online" }, { "2025-01-04T00:00:00", 2, 300, 3, "Store" }, { "2025-01-05T00:00:00", 3, 400, 1, "Online" }, { "2025-01-06T00:00:00", 4, 500, 2, "Store" }, { "2025-01-07T00:00:00", 1, 100, 3, "Online" }, { "2026-01-01T00:00:00", 2, 400, 1, "Store" }, { "2026-01-02T00:00:00", 3, 600, 2, "Online" }, { "2026-01-03T00:00:00", 4, 800, 3, "Store" }, { "2026-01-04T00:00:00", 1, 1000, 1, "Online" }, { "2026-01-05T00:00:00", 2, 200, 2, "Store" }, { "2026-01-06T00:00:00", 3, 400, 3, "Online" }, { "2026-01-07T00:00:00", 4, 600, 1, "Store" } } )
