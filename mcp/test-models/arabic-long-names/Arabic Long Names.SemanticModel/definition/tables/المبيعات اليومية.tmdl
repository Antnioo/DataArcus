table 'المبيعات اليومية'

	measure 'إجمالي صافي المبيعات بعد الخصومات والمرتجعات' = SUM ( 'المبيعات اليومية'[صافي المبلغ] )
		formatString: #,0

	measure 'عدد الفواتير الصادرة خلال الفترة المحددة' = COUNTROWS ( 'المبيعات اليومية' )
		formatString: #,0

	measure 'متوسط قيمة الفاتورة الواحدة بعد الخصم' = DIVIDE ( [إجمالي صافي المبيعات بعد الخصومات والمرتجعات], [عدد الفواتير الصادرة خلال الفترة المحددة] )
		formatString: #,0.00

	measure 'نسبة النمو مقارنة بنفس الفترة من العام الماضي' = ```
			VAR _LY = CALCULATE ( [إجمالي صافي المبيعات بعد الخصومات والمرتجعات], SAMEPERIODLASTYEAR ( التقويم[التاريخ] ) )
			RETURN DIVIDE ( [إجمالي صافي المبيعات بعد الخصومات والمرتجعات] - _LY, _LY )
			```
		formatString: 0.0%

	measure 'إجمالي الكمية المباعة من جميع الأصناف' = SUM ( 'المبيعات اليومية'[الكمية] )
		formatString: #,0

	column التاريخ
		dataType: dateTime
		isHidden
		sourceColumn: التاريخ

	column 'رمز الفرع'
		dataType: int64
		isHidden
		sourceColumn: رمز الفرع

	column 'صافي المبلغ'
		dataType: double
		isHidden
		sourceColumn: صافي المبلغ

	column الكمية
		dataType: int64
		isHidden
		sourceColumn: الكمية

	column 'قناة البيع المستخدمة في إتمام العملية'
		dataType: string
		sourceColumn: قناة البيع المستخدمة في إتمام العملية

	partition 'المبيعات اليومية' = m
		mode: import
		source =
				let
				    Source = #table({"التاريخ", "رمز الفرع", "صافي المبلغ", "الكمية", "قناة البيع المستخدمة في إتمام العملية"}, {{#datetime(2025, 1, 1, 0, 0, 0), 1, 100, 1, "Online"}, {#datetime(2025, 1, 2, 0, 0, 0), 2, 200, 2, "Store"}, {#datetime(2025, 1, 3, 0, 0, 0), 3, 300, 3, "Online"}, {#datetime(2025, 1, 4, 0, 0, 0), 4, 400, 1, "Store"}, {#datetime(2025, 1, 5, 0, 0, 0), 1, 500, 2, "Online"}, {#datetime(2025, 1, 6, 0, 0, 0), 2, 100, 3, "Store"}, {#datetime(2025, 1, 7, 0, 0, 0), 3, 200, 1, "Online"}, {#datetime(2026, 1, 1, 0, 0, 0), 4, 600, 2, "Store"}, {#datetime(2026, 1, 2, 0, 0, 0), 1, 800, 3, "Online"}, {#datetime(2026, 1, 3, 0, 0, 0), 2, 1000, 1, "Store"}, {#datetime(2026, 1, 4, 0, 0, 0), 3, 200, 2, "Online"}, {#datetime(2026, 1, 5, 0, 0, 0), 4, 400, 3, "Store"}, {#datetime(2026, 1, 6, 0, 0, 0), 1, 600, 1, "Online"}, {#datetime(2026, 1, 7, 0, 0, 0), 2, 800, 2, "Store"}, {#datetime(2025, 1, 1, 0, 0, 0), 3, 500, 3, "Online"}, {#datetime(2025, 1, 2, 0, 0, 0), 4, 100, 1, "Store"}, {#datetime(2025, 1, 3, 0, 0, 0), 1, 200, 2, "Online"}, {#datetime(2025, 1, 4, 0, 0, 0), 2, 300, 3, "Store"}, {#datetime(2025, 1, 5, 0, 0, 0), 3, 400, 1, "Online"}, {#datetime(2025, 1, 6, 0, 0, 0), 4, 500, 2, "Store"}, {#datetime(2025, 1, 7, 0, 0, 0), 1, 100, 3, "Online"}, {#datetime(2026, 1, 1, 0, 0, 0), 2, 400, 1, "Store"}, {#datetime(2026, 1, 2, 0, 0, 0), 3, 600, 2, "Online"}, {#datetime(2026, 1, 3, 0, 0, 0), 4, 800, 3, "Store"}, {#datetime(2026, 1, 4, 0, 0, 0), 1, 1000, 1, "Online"}, {#datetime(2026, 1, 5, 0, 0, 0), 2, 200, 2, "Store"}, {#datetime(2026, 1, 6, 0, 0, 0), 3, 400, 3, "Online"}, {#datetime(2026, 1, 7, 0, 0, 0), 4, 600, 1, "Store"}})
				in
				    Source
