table التقويم
	dataCategory: Time

	column 'التاريخ'
		dataType: dateTime
		isNameInferred
		isDataTypeInferred
		sourceColumn: [التاريخ]

	column 'السنة'
		dataType: int64
		isNameInferred
		isDataTypeInferred
		sourceColumn: [السنة]

	column 'رقم الشهر'
		dataType: int64
		isNameInferred
		isDataTypeInferred
		sourceColumn: [رقم الشهر]

	column 'اسم الشهر'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [اسم الشهر]

	column 'رقم اليوم في الأسبوع'
		dataType: int64
		isNameInferred
		isDataTypeInferred
		sourceColumn: [رقم اليوم في الأسبوع]

	column 'اسم اليوم'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [اسم اليوم]

	column 'السنة الهجرية'
		dataType: int64
		isNameInferred
		isDataTypeInferred
		sourceColumn: [السنة الهجرية]

	column 'هل هو شهر رمضان'
		dataType: boolean
		isNameInferred
		isDataTypeInferred
		sourceColumn: [هل هو شهر رمضان]

	partition التقويم = calculated
		mode: import
		source = DATATABLE ( "التاريخ", DATETIME, "السنة", INTEGER, "رقم الشهر", INTEGER, "اسم الشهر", STRING, "رقم اليوم في الأسبوع", INTEGER, "اسم اليوم", STRING, "السنة الهجرية", INTEGER, "هل هو شهر رمضان", BOOLEAN, { { "2025-01-01", 2025, 1, "January", 4, "Wednesday", 1446, FALSE }, { "2025-02-02", 2025, 2, "February", 1, "Sunday", 1446, FALSE }, { "2025-03-03", 2025, 3, "March", 2, "Monday", 1446, FALSE }, { "2025-04-04", 2025, 4, "April", 6, "Friday", 1446, FALSE }, { "2025-05-05", 2025, 5, "May", 2, "Monday", 1446, FALSE }, { "2025-06-06", 2025, 6, "June", 6, "Friday", 1446, FALSE }, { "2025-07-07", 2025, 7, "July", 2, "Monday", 1446, FALSE }, { "2026-01-01", 2026, 1, "January", 5, "Thursday", 1447, FALSE }, { "2026-02-02", 2026, 2, "February", 2, "Monday", 1447, FALSE }, { "2026-03-03", 2026, 3, "March", 3, "Tuesday", 1447, FALSE }, { "2026-04-04", 2026, 4, "April", 7, "Saturday", 1447, FALSE }, { "2026-05-05", 2026, 5, "May", 3, "Tuesday", 1447, FALSE }, { "2026-06-06", 2026, 6, "June", 7, "Saturday", 1447, FALSE }, { "2026-07-07", 2026, 7, "July", 3, "Tuesday", 1447, FALSE } } )
