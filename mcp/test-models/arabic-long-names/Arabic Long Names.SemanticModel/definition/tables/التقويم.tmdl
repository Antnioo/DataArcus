table التقويم
	dataCategory: Time

	column 'التاريخ'
		dataType: dateTime
		isNameInferred
		isDataTypeInferred
		sourceColumn: [التاريخ]

	column 'السنة'
		dataType: int64
		isNameInferred
		isDataTypeInferred
		sourceColumn: [السنة]

	column 'رقم الشهر'
		dataType: int64
		isNameInferred
		isDataTypeInferred
		sourceColumn: [رقم الشهر]

	column 'اسم الشهر'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [اسم الشهر]

	column 'رقم اليوم في الأسبوع'
		dataType: int64
		isNameInferred
		isDataTypeInferred
		sourceColumn: [رقم اليوم في الأسبوع]

	column 'اسم اليوم'
		dataType: string
		isNameInferred
		isDataTypeInferred
		sourceColumn: [اسم اليوم]

	column 'السنة الهجرية'
		dataType: int64
		isNameInferred
		isDataTypeInferred
		sourceColumn: [السنة الهجرية]

	column 'هل هو شهر رمضان'
		dataType: boolean
		isNameInferred
		isDataTypeInferred
		sourceColumn: [هل هو شهر رمضان]

	partition التقويم = calculated
		mode: import
		source = DATATABLE ( "التاريخ", DATETIME, "السنة", INTEGER, "رقم الشهر", INTEGER, "اسم الشهر", STRING, "رقم اليوم في الأسبوع", INTEGER, "اسم اليوم", STRING, "السنة الهجرية", INTEGER, "هل هو شهر رمضان", BOOLEAN, { { "2025-01-01", 2025, 1, "January", 4, "Wednesday", 1446, FALSE }, { "2025-01-02", 2025, 1, "January", 5, "Thursday", 1446, FALSE }, { "2025-01-03", 2025, 1, "January", 6, "Friday", 1446, FALSE }, { "2025-01-04", 2025, 1, "January", 7, "Saturday", 1446, FALSE }, { "2025-01-05", 2025, 1, "January", 1, "Sunday", 1446, FALSE }, { "2025-01-06", 2025, 1, "January", 2, "Monday", 1446, FALSE }, { "2025-01-07", 2025, 1, "January", 3, "Tuesday", 1446, FALSE }, { "2026-01-01", 2026, 1, "January", 5, "Thursday", 1447, FALSE }, { "2026-01-02", 2026, 1, "January", 6, "Friday", 1447, FALSE }, { "2026-01-03", 2026, 1, "January", 7, "Saturday", 1447, FALSE }, { "2026-01-04", 2026, 1, "January", 1, "Sunday", 1447, FALSE }, { "2026-01-05", 2026, 1, "January", 2, "Monday", 1447, FALSE }, { "2026-01-06", 2026, 1, "January", 3, "Tuesday", 1447, FALSE }, { "2026-01-07", 2026, 1, "January", 4, "Wednesday", 1447, FALSE } } )
