table التقويم
	dataCategory: Time

	column التاريخ
		dataType: dateTime
		isKey
		sourceColumn: التاريخ

	column السنة
		dataType: int64
		sourceColumn: السنة

	column 'رقم الشهر'
		dataType: int64
		isHidden
		sourceColumn: رقم الشهر

	column 'اسم الشهر'
		dataType: string
		sortByColumn: 'رقم الشهر'
		sourceColumn: اسم الشهر

	column 'رقم اليوم في الأسبوع'
		dataType: int64
		isHidden
		sourceColumn: رقم اليوم في الأسبوع

	column 'اسم اليوم'
		dataType: string
		sortByColumn: 'رقم اليوم في الأسبوع'
		sourceColumn: اسم اليوم

	column 'السنة الهجرية'
		dataType: int64
		sourceColumn: السنة الهجرية

	column 'هل هو شهر رمضان'
		dataType: boolean
		sourceColumn: هل هو شهر رمضان

	partition التقويم = m
		mode: import
		source =
				let
				    Source = #table(type table [#"التاريخ" = datetime, #"السنة" = Int64.Type, #"رقم الشهر" = Int64.Type, #"اسم الشهر" = text, #"رقم اليوم في الأسبوع" = Int64.Type, #"اسم اليوم" = text, #"السنة الهجرية" = Int64.Type, #"هل هو شهر رمضان" = logical], {{#datetime(2025, 1, 1, 0, 0, 0), 2025, 1, "January", 4, "Wednesday", 1446, false}, {#datetime(2025, 2, 1, 0, 0, 0), 2025, 2, "February", 7, "Saturday", 1446, false}, {#datetime(2025, 3, 1, 0, 0, 0), 2025, 3, "March", 7, "Saturday", 1446, true}, {#datetime(2025, 4, 1, 0, 0, 0), 2025, 4, "April", 3, "Tuesday", 1446, false}, {#datetime(2025, 5, 1, 0, 0, 0), 2025, 5, "May", 5, "Thursday", 1446, false}, {#datetime(2025, 6, 1, 0, 0, 0), 2025, 6, "June", 1, "Sunday", 1446, false}, {#datetime(2025, 7, 1, 0, 0, 0), 2025, 7, "July", 3, "Tuesday", 1447, false}, {#datetime(2026, 1, 1, 0, 0, 0), 2026, 1, "January", 5, "Thursday", 1447, false}, {#datetime(2026, 2, 1, 0, 0, 0), 2026, 2, "February", 1, "Sunday", 1447, false}, {#datetime(2026, 3, 1, 0, 0, 0), 2026, 3, "March", 1, "Sunday", 1447, true}, {#datetime(2026, 4, 1, 0, 0, 0), 2026, 4, "April", 4, "Wednesday", 1447, false}, {#datetime(2026, 5, 1, 0, 0, 0), 2026, 5, "May", 6, "Friday", 1447, false}, {#datetime(2026, 6, 1, 0, 0, 0), 2026, 6, "June", 2, "Monday", 1447, false}, {#datetime(2026, 7, 1, 0, 0, 0), 2026, 7, "July", 4, "Wednesday", 1448, false}})
				in
				    Source
